# --- Application ---
APP_NAME=Geospatial Measurement API
ENVIRONMENT=development
LOG_LEVEL=INFO
# "json" for production log aggregation, "console" for readable local output
LOG_FORMAT=console

# --- Database (asyncpg driver is enforced automatically; postgres:// URLs are accepted) ---
# Local (no Docker):  postgresql+asyncpg://postgres:postgres@localhost:5432/geospatial
# Docker Compose overrides the host to "db" itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geospatial
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Used by docker-compose.yml for the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geospatial

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Zip-bomb guards for Shapefile archives
MAX_EXTRACTED_SIZE_MB=500
MAX_ZIP_MEMBERS=200

# --- API ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
# File listing (GET /api/files/)
LIST_DEFAULT_PAGE_SIZE=20
LIST_MAX_PAGE_SIZE=100

# --- CORS / frontend ---
# Comma-separated browser origins allowed to call the API. If unset: "*" when ENVIRONMENT=development,
# otherwise CORS is disabled (fine when the built frontend is served by this app on the same origin).
# ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# Directory with the built frontend (npm run build). Served at "/" when it exists.
FRONTEND_DIST_DIR=frontend/dist
